# Copy to .env for local development. Replace every placeholder before use.
DATABASE_URL="file:../db/custom.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
ENCRYPTION_KEY="replace-with-a-different-unique-random-secret-at-least-32-characters"

# Required for unattended MT4/MT5 monitoring and order commands.
SCANNER_WORKER_TOKEN="replace-with-a-unique-random-secret-at-least-32-characters"
APP_INTERNAL_URL="http://127.0.0.1:3000"
SCANNER_INTERVAL_MS="3000"

# Authenticated real-time event delivery service.
EVENTS_SERVICE_URL="http://127.0.0.1:3003"
EVENTS_PORT="3003"
EVENTS_SERVICE_TOKEN="replace-with-a-different-unique-random-secret-at-least-32-characters"
NEXT_PUBLIC_EVENTS_SERVICE_URL="http://localhost:3003"
WEB_ORIGINS="http://localhost:3000"

# Optional official account-linking credentials. Register each callback URL with
# the provider; set NEXTAUTH_URL to the exact public origin in production.
DERIV_CLIENT_ID=""
DERIV_REDIRECT_URI="http://localhost:3000/api/brokers/deriv/callback"
CTRADER_CLIENT_ID=""
CTRADER_CLIENT_SECRET=""
CTRADER_REDIRECT_URI="http://localhost:3000/api/brokers/ctrader/callback"
# FXCM MT4 accounts use the MetaTrader bridge. Trading Station OAuth needs an approved integration.
FXCM_CLIENT_ID=""
FXCM_CLIENT_SECRET=""
FXCM_ENVIRONMENT="demo"
FXCM_REDIRECT_URI="http://localhost:3000/api/brokers/fxcm/callback"
